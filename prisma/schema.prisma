generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

model User {
  id                    String          @id @default(cuid())
  name                  String?
  email                 String          @unique
  password              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  currentPersona        String?
  emailVerified         DateTime?
  futureVision          String?
  image                 String?
  resetToken            String?         @unique
  resetTokenExpiry      DateTime?
  verifyToken           String?         @unique
  verifyTokenExpiry     DateTime?
  accounts              Account[]
  Cache                 Cache[]
  conversations         Conversation[]
  insights              Insight[]
  notes                 Note[]
  incomingProposals     Partnership[]   @relation("IncomingProposals")
  suggestedPartnerships Partnership[]   @relation("SuggestedPartnerships")
  partnerships          Partnership[]
  socialAccounts        SocialAccount[]
  socialUpdates         SocialUpdate[]
  sessions              Session[]
  emailContents         EmailContent[]
  emailSearchCache      EmailSearchCache[]
  emailThreads          EmailThread[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_token     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Insight {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  description String
  impact      String
  timing      String
  confidence  Int
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Conversation {
  id              String            @id @default(cuid())
  userId          String
  title           String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        Message[]
  starred         Boolean           @default(false)
  state           ConversationState?
  user            User              @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Message {
  id                  String       @id @default(cuid())
  content             String
  role                String
  timestamp           DateTime     @default(now())
  conversationId      String
  referencedMessageId String?
  conversation        Conversation @relation(fields: [conversationId], references: [id])
  referencedMessage   Message?     @relation("MessageReference", fields: [referencedMessageId], references: [id])
  referencedBy        Message[]    @relation("MessageReference")

  @@index([conversationId])
}

model SocialUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  platform  String
  type      String
  data      Json
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  platform     String
  name         String?
  username     String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  tokenType    String?
  scope        String?
  profileUrl   String?
  avatarUrl    String?
  metadata     Json?
  isConnected  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  metrics      Json?
  partnerships Json?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model Partnership {
  id             String                   @id @default(cuid())
  userId         String
  name           String
  status         String                   @default("pending")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  proposedToId   String?
  suggestedToId  String?
  brand          String                   @default("")
  type           String                   @default("email")
  alignmentScore Float                    @default(0)
  confidence     Float?
  deadline       DateTime?
  estimatedValue Decimal?
  lastContact    DateTime?
  potentialValue Decimal?
  progress       Float                    @default(0)
  signals        Json?
  value          Decimal?
  receivedDate   DateTime?
  description    String                   @default("")
  contacts       Contact[]
  proposedTo     User?                    @relation("IncomingProposals", fields: [proposedToId], references: [id])
  suggestedTo    User?                    @relation("SuggestedPartnerships", fields: [suggestedToId], references: [id])
  user           User                     @relation(fields: [userId], references: [id])
  events         PartnershipEvent[]
  history        PartnershipHistory[]
  requirements   PartnershipRequirement[]

  @@index([userId])
  @@index([proposedToId])
  @@index([suggestedToId])
}

model PartnershipRequirement {
  id            String      @id @default(cuid())
  partnershipId String
  title         String
  completed     Boolean     @default(false)
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model PartnershipEvent {
  id            String      @id @default(cuid())
  partnershipId String
  date          DateTime
  type          String?
  description   String?
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model Contact {
  id            String      @id @default(cuid())
  partnershipId String
  name          String
  email         String?
  phone         String?
  role          String?
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model PartnershipHistory {
  id            String      @id @default(cuid())
  partnershipId String
  date          DateTime
  details       String?
  event         String
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String
  type       String?  @default("default")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  important  Boolean  @default(false)
  tags       String[]
  references Json[]
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cache {
  id        String   @id
  key       String
  value     String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key, createdAt])
  @@index([userId])
}

model rag_documents {
  id          String   @id @default(uuid())
  content     String
  content_hash String  @unique
  metadata    Json
  embedding   Unsupported("vector") @default(dbgenerated("'[]'::vector"))
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([content_hash])
}

model rag_documents_input {
  id           String   @id @default(uuid())
  content_hash String
  content      String
  metadata     Json
  embedding    Json
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([content_hash])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ConversationState {
  id                String       @id @default(cuid())
  conversationId    String       @unique
  currentTopic      String?
  lastTopic         String?
  topicDepth        Int          @default(0)
  contextStack      Json         @default("[]")
  pendingActions    Json         @default("[]")
  lastResponseType  String       @default("answer")
  emotionalState    Json
  userIntent        Json
  focusMetrics      Json
  conversationFlow  Json
  mentionedEntities Json?
  queryContext      Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model EmailContent {
  id              String    @id @default(cuid())
  messageId       String    @unique
  threadId        String
  userId          String
  subject         String
  from            String
  to              String[]
  cc              String[]
  bcc             String[]
  body            String
  snippet         String?
  date            DateTime
  labels          String[]
  isRead          Boolean   @default(false)
  isStarred       Boolean   @default(false)
  hasAttachments  Boolean   @default(false)
  attachments     Json?
  analysis        EmailAnalysis?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchVector    Unsupported("tsvector") @default(dbgenerated("to_tsvector('english', coalesce(subject, '') || ' ' || coalesce(body, '') || ' ' || coalesce(\"from\", ''))"))
  thread          EmailThread? @relation(fields: [threadId], references: [threadId])

  @@index([userId])
  @@index([threadId])
  @@index([messageId])
  @@index([searchVector], type: Gin)
}

model EmailAnalysis {
  id              String    @id @default(cuid())
  emailId         String    @unique
  keyPoints       String[]
  topics          String[]
  participants    String[]
  timeline        Json      // Array of {date: string, event: string}
  sentiment       String    @default("neutral")
  actionItems     String[]
  summary         String
  importance      Float     @default(0)
  useCount        Int       @default(0)
  lastAccessed    DateTime  @default(now())
  threadContext   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  email          EmailContent @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailSearchCache {
  id              String    @id @default(cuid())
  query           String
  userId          String
  results         Json      // Array of email IDs with scores
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([query, userId])
  @@index([userId])
  @@index([expiresAt])
}

model EmailThread {
  id              String    @id @default(cuid())
  threadId        String    @unique  // Original email thread ID
  userId          String
  subject         String
  participants    String[]
  lastMessageDate DateTime
  messageCount    Int       @default(0)
  isArchived      Boolean   @default(false)
  status          String    @default("active")  // active, archived, muted
  labels          String[]
  metadata        Json?     // Additional thread metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis        ThreadAnalysis?
  context         ThreadContext?
  state           ThreadState?
  relationships   ThreadRelationship[] @relation("ThreadToThread")
  relatedTo       ThreadRelationship[] @relation("RelatedThread")
  emails          EmailContent[]

  @@index([userId])
  @@index([threadId])
  @@index([lastMessageDate])
}

model ThreadAnalysis {
  id              String    @id @default(cuid())
  threadId        String    @unique
  summary         String    // Thread summary
  topics          String[]  // Main topics discussed
  keyPoints       String[]  // Important points from the thread
  sentiment       String    @default("neutral")
  participants    Json      // Participant roles and engagement metrics
  timeline        Json      // Thread activity timeline
  actionItems     String[]  // Action items extracted from thread
  context         String?   // Overall thread context
  importance      Float     @default(0)
  complexity      Float     @default(0)
  engagementLevel Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  thread          EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model ThreadRelationship {
  id              String    @id @default(cuid())
  threadId        String    // Source thread
  relatedThreadId String    // Related thread
  relationshipType String   // reply, forward, reference, split, merge
  strength        Float     // Relationship strength (0-1)
  evidence        Json      // Evidence supporting the relationship
  metadata        Json?     // Additional relationship metadata
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  thread          EmailThread @relation("ThreadToThread", fields: [threadId], references: [id], onDelete: Cascade)
  relatedThread   EmailThread @relation("RelatedThread", fields: [relatedThreadId], references: [id], onDelete: Cascade)

  @@unique([threadId, relatedThreadId])
  @@index([threadId])
  @@index([relatedThreadId])
}

model ThreadContext {
  id              String    @id @default(cuid())
  threadId        String    @unique
  context         String    @db.Text  // Using Text type for potentially long context
  lastUpdated     DateTime  @updatedAt
  version         Int       @default(1)
  metadata        Json      // Contains languageCode, contextType, and confidenceScore
  createdAt       DateTime  @default(now())
  thread          EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model ThreadState {
  id              String    @id @default(cuid())
  threadId        String    @unique
  status          String    // active, resolved, pending, archived
  priority        String    // high, medium, low
  category        String[]  // Array of business categories
  lastStateChange DateTime  @updatedAt
  assignedTo      String?   // Email of assigned person
  createdAt       DateTime  @default(now())
  thread          EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([status])
  @@index([priority])
}
