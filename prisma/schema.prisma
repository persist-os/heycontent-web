generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String          @id @default(cuid())
  name                  String?
  email                 String          @unique
  password              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  currentPersona        String?
  emailVerified         DateTime?
  futureVision          String?
  image                 String?
  resetToken            String?         @unique
  resetTokenExpiry      DateTime?
  verifyToken           String?         @unique
  verifyTokenExpiry     DateTime?
  accounts              Account[]
  Cache                 Cache[]
  conversations         Conversation[]
  insights              Insight[]
  notes                 Note[]
  incomingProposals     Partnership[]   @relation("IncomingProposals")
  suggestedPartnerships Partnership[]   @relation("SuggestedPartnerships")
  partnerships          Partnership[]
  socialAccounts        SocialAccount[]
  socialUpdates         SocialUpdate[]
  sessions              Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_token     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Insight {
  id          Int      @id @default(autoincrement())
  type        String
  title       String
  description String
  impact      String
  timing      String
  confidence  Int
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  starred   Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id])
  messages  Message[]

  @@index([userId])
}

model Message {
  id                  String       @id @default(cuid())
  content             String
  role                String
  timestamp           DateTime     @default(now())
  conversationId      String
  referencedMessageId String?
  conversation        Conversation @relation(fields: [conversationId], references: [id])
  referencedMessage   Message?     @relation("MessageReference", fields: [referencedMessageId], references: [id])
  referencedBy        Message[]    @relation("MessageReference")

  @@index([conversationId])
}

model SocialUpdate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  platform  String
  type      String
  data      Json
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SocialAccount {
  id           String    @id @default(cuid())
  userId       String
  platform     String
  name         String?
  username     String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  tokenType    String?
  scope        String?
  profileUrl   String?
  avatarUrl    String?
  metadata     Json?
  isConnected  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  metrics      Json?
  partnerships Json?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model Partnership {
  id             String                   @id @default(cuid())
  userId         String
  name           String
  status         String                   @default("pending")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  proposedToId   String?
  suggestedToId  String?
  brand          String                   @default("")
  type           String                   @default("email")
  alignmentScore Float                    @default(0)
  confidence     Float?
  deadline       DateTime?
  estimatedValue Decimal?
  lastContact    DateTime?
  potentialValue Decimal?
  progress       Float                    @default(0)
  signals        Json?
  value          Decimal?
  receivedDate   DateTime?
  description    String                   @default("")
  contacts       Contact[]
  proposedTo     User?                    @relation("IncomingProposals", fields: [proposedToId], references: [id])
  suggestedTo    User?                    @relation("SuggestedPartnerships", fields: [suggestedToId], references: [id])
  user           User                     @relation(fields: [userId], references: [id])
  events         PartnershipEvent[]
  history        PartnershipHistory[]
  requirements   PartnershipRequirement[]

  @@index([userId])
  @@index([proposedToId])
  @@index([suggestedToId])
}

model PartnershipRequirement {
  id            String      @id @default(cuid())
  partnershipId String
  title         String
  completed     Boolean     @default(false)
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model PartnershipEvent {
  id            String      @id @default(cuid())
  partnershipId String
  date          DateTime
  type          String?
  description   String?
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model Contact {
  id            String      @id @default(cuid())
  partnershipId String
  name          String
  email         String?
  phone         String?
  role          String?
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model PartnershipHistory {
  id            String      @id @default(cuid())
  partnershipId String
  date          DateTime
  details       String?
  event         String
  partnership   Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  title      String
  content    String
  type       String?  @default("default")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  important  Boolean  @default(false)
  tags       String[]
  references Json[]
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cache {
  id        String   @id
  key       String
  value     String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key, createdAt])
  @@index([userId])
}

model rag_documents {
  id          String   @id @default(uuid())
  content     String
  content_hash String  @unique
  metadata    Json
  embedding   Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([content_hash])
  @@index([metadata])
}

model rag_documents_input {
  content_hash String
  content      String
  metadata     Json
  embedding    Json
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
