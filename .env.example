# Next Auth Configuration
# URL where your application is running
NEXTAUTH_URL="http://localhost:3000"
# Secret key for NextAuth.js (min 32 chars) - Generate a secure random string
NEXTAUTH_SECRET="your-nextauth-secret-at-least-32-chars"

# Google OAuth
# Client ID from Google Cloud Console (required for authentication and Gmail API)
GOOGLE_CLIENT_ID="your-google-client-id"
# Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenAI Configuration
# API key from OpenAI dashboard (required for AI features)
OPENAI_API_KEY="your-openai-api-key"

# Email Service
# API key from Resend.com (required for sending verification emails)
RESEND_API_KEY="your-resend-api-key"

# Application URLs
# Public URL of your application (used for email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
# Application environment (development/production)
NODE_ENV="development" 