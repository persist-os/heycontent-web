# Application URLs
# Public URL of your application (used for email links and OAuth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth
# Client ID from Google Cloud Console (required for authentication and Gmail API)
GOOGLE_CLIENT_ID="your-google-client-id"
# Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google OAuth Redirect URIs
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/social/callback/youtube/oauth"
GMAIL_REDIRECT_URI="http://localhost:3000/api/social/callback/gmail"

# Email Service
# API key from Resend.com (required for sending verification emails)
RESEND_API_KEY="your-resend-api-key"

# Application URLs
# Public URL of your application (used for email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature Flags
# Application environment (development/production)
NODE_ENV="development"


# Convex - Database
NEXT_PUBLIC_CONVEX_URL="your-convex-deployment-url"

# Firebase - Authentication
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Firebase Admin SDK - Server-side Authentication
# These are needed for server-side token verification
# Download service account key from Firebase Console > Project Settings > Service Accounts
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"