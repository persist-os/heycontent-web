# Google OAuth
# Client ID from Google Cloud Console (required for authentication and Gmail API)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
# Client Secret from Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Application URLs
# Public URL of your application (used for email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend URL
# Note: Swap this out for localhost to test the backend locally
NEXT_PUBLIC_BACKEND_URL="https://backend.hicontent.co"
# NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# Feature Flags
# Application environment (development/production)
NODE_ENV="development"

# Convex - Database
NEXT_PUBLIC_CONVEX_URL="your-convex-deployment-url"

# Firebase - Authentication
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Vertex AI Configuration
GOOGLE_CLOUD_PROJECT_ID="your-google-cloud-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"